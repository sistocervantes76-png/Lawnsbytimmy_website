{
  // Test Worker only. Do not deploy this file as lawnsbytimmy-website.
  // Use: npx wrangler deploy -c wrangler.booking-test.jsonc
  // Production uses wrangler.jsonc. This file stays the test Worker.
  "name": "lbt-booking-test",
  "main": "src/booking-worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },
  "vars": {
    "BOOKING_MODE": "test",
    "BOOKING_WORKER": "test"
  },
  "durable_objects": {
    "bindings": [
      { "name": "SLOT_LEDGER", "class_name": "SlotLedger" }
    ]
  },
  "migrations": [
    { "tag": "v1-slot-ledger", "new_sqlite_classes": ["SlotLedger"] }
  ]
}
