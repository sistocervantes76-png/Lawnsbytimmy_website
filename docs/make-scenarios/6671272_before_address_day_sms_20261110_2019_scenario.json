      "follows": 8
    },
    {
      "id": 10,
      "module": "google-email:sendAnEmail",
      "version": 4,
      "parent": {
        "moduleId": 12,
        "kind": "route",
        "index": 1
      },
      "filter": {
        "name": "Called again within 24h (already texted)",
        "conditions": [
          [
            {
              "a": "{{6.opted_out}}",
              "b": "true",
              "o": "text:notequal"
            },
            {
              "a": "{{6.last_texted_at}}",
              "b": "{{addHours(now; -24)}}",
              "o": "date:greaterorequal"
            }
          ]
        ]
      }
    },
    {
