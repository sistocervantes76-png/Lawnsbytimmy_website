    {
      "id": 5,
      "module": "util:SetVariables",
      "version": 1,
      "follows": 3,
      "filter": {
        "name": "Real caller number",
        "conditions": [
          [
            {
              "a": "{{length(replace(replace(replace(replace(replace(3.parties[1].from.phoneNumber; \"+\"; emptystring); \"-\"; emptystring); \" \"; emptystring); \"(\"; emptystring); \")\"; emptystring))}}",
              "b": "10",
              "o": "number:greaterorequal"
            }
          ]
        ]
      }
    },
    {
      "id": 22,
      "module": "builtin:Break",
      "version": 1,
      "parent": {
        "moduleId": 5,
        "kind": "errorHandler"
      }
    },
    {
      "id": 6,
      "module": "datastore:GetRecord",
      "version": 1,
      "follows": 5
    },
    {
      "id": 12,
      "module": "builtin:BasicRouter",
      "version": 1,
      "follows": 6
    },
    {
      "id": 4,
      "module": "ringcentral:sendSMSMMS",
      "version": 1,
      "parent": {
        "moduleId": 12,
        "kind": "route",
        "index": 0
      },
      "filter": {
        "name": "Not opted out + not texted in last 24h",
        "conditions": [
          [
            {
              "a": "{{6.opted_out}}",
              "b": "true",
              "o": "text:notequal"
            },
            {
              "a": "{{6.last_texted_at}}",
              "o": "notexist"
            }
          ],
          [
            {
              "a": "{{6.opted_out}}",
              "b": "true",
              "o": "text:notequal"
            },
            {
              "a": "{{6.last_texted_at}}",
              "b": "{{addHours(now; -24)}}",
              "o": "date:less"
            }
          ]
        ]
      }
    },
    {
      "id": 20,
      "module": "google-email:sendAnEmail",
      "version": 4,
      "parent": {
        "moduleId": 4,
        "kind": "errorHandler"
      }
    },
    {
      "id": 21,
      "module": "builtin:Ignore",
      "version": 1,
      "follows": 20
    },
    {
      "id": 7,
