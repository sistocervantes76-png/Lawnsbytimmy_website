        },
        "mapper": {
          "to": [
            "{{1.lead_data.email}}"
          ],
          "content": "<p>Hi {{1.lead_data.first_name}},</p>\r\n<p>Thanks for your request for <strong>{{1.lead_data.service_address}}, {{1.lead_data.city}}</strong>.</p>\r\n<p style=\"font-size:18px\"><strong>Your price: ${{sum(6.base; 6.trip)}} per visit</strong> for {{lower(1.lead_data.frequency)}} mowing ({{1.lead_data.lot_size}}).</p>\r\n<p>This price is based on the yard size you picked. If your yard turns out bigger, we'll tell you the new price before the first mow. Nothing is charged until you say yes.</p>\r\n<p><strong>Next steps:</strong><br>1. Reply with 2 or 3 photos of your yard.<br>2. We'll confirm your first mow day.<br>3. We'll send a secure link to put a card on file before the first visit.</p>\r\n<p>Thank you,<br>Sisto<br>Lawns by Timmy<br><a href=\"https://lawnsbytimmy.com\">lawnsbytimmy.com</a></p>",
          "subject": "Your Lawns by Timmy price, {{1.lead_data.first_name}}",
          "bodyType": "rawHtml"
        },
        "restore": {
          "expect": {
            "cc": {
              "mode": "chose"
            },
            "to": {
              "mode": "chose",
              "items": [
                null
              ]
            },
            "bcc": {
              "mode": "chose"
            },
            "from": {
              "mode": "chose"
            },
            "bodyType": {
              "label": "Raw HTML"
