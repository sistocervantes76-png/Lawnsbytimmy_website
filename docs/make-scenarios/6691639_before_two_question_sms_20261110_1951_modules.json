        "mapper": {
          "count": "3",
          "retry": true,
          "interval": "15"
        }
      }
    },
    {
      "id": 13,
      "module": "google-sheets:addRow",
      "version": 2,
      "config": {
        "parameters": {
          "__IMTCONN__": "REDACTED_CONNECTION_ID"
        },
        "mapper": {
          "from": "drive",
          "mode": "select",
          "values": {
            "0": "{{formatDate(now; \"M/D/YYYY h:mm A\"; \"America/New_York\")}}",
            "1": "LBT Text Replies + STOP",
            "2": "STOP: save opt-out",
            "3": "{{2.num}}",
            "4": "{{1.subject}}",
            "5": "{{ifempty(ifempty(4.error.type; 4.error.name); \"Unknown\")}}",
            "6": "{{4.error.message}}",
            "7": "Held in Make > Incomplete executions. Fix the cause, then click Retry there.",
            "8": "No"
          },
          "sheetId": "Error Log",
          "spreadsheetId": "/REDACTED_SPREADSHEET_ID",
          "includesHeaders": true,
          "insertDataOption": "INSERT_ROWS",
          "useColumnHeaders": false,
          "valueInputOption": "USER_ENTERED",
          "insertUnformatted": false
