{
  "modules": [
    {
      "id": 1,
      "module": "ringcentral:incomingMessages",
      "version": 1,
      "config": {
        "parameters": {
          "__IMTHOOK__": "REDACTED_HOOK_ID"
        },
        "mapper": {}
      }
    },
    {
      "id": 2,
      "module": "util:SetVariables",
      "version": 1,
      "config": {
        "parameters": {},
        "mapper": {
          "variables": [
            {
              "name": "digits",
              "value": "{{replace(replace(replace(replace(replace(replace(1.from.phoneNumber; \"+\"; emptystring); \"-\"; emptystring); \" \"; emptystring); \"(\"; emptystring); \")\"; emptystring); \".\"; emptystring)}}"
            },
            {
              "name": "num",
              "value": "+{{if(length(replace(replace(replace(replace(replace(replace(1.from.phoneNumber; \"+\"; emptystring); \"-\"; emptystring); \" \"; emptystring); \"(\"; emptystring); \")\"; emptystring); \".\"; emptystring)) = 10; \"1\"; emptystring)}}{{replace(replace(replace(replace(replace(replace(1.from.phoneNumber; \"+\"; emptystring); \"-\"; emptystring); \" \"; emptystring); \"(\"; emptystring); \")\"; emptystring); \".\"; emptystring)}}"
            },
            {
              "name": "word",
              "value": "{{lower(trim(replace(replace(replace(1.subject; \".\"; emptystring); \"!\"; emptystring); \",\"; emptystring)))}}"
            },
            {
              "name": "kind",
              "value": "{{switch(lower(trim(replace(replace(replace(1.subject; \".\"; emptystring); \"!\"; emptystring); \",\"; emptystring))); \"stop\"; \"stop\"; \"stopall\"; \"stop\"; \"stop all\"; \"stop\"; \"unsubscribe\"; \"stop\"; \"cancel\"; \"stop\"; \"end\"; \"stop\"; \"quit\"; \"stop\"; \"optout\"; \"stop\"; \"opt out\"; \"stop\"; \"revoke\"; \"stop\"; \"start\"; \"start\"; \"unstop\"; \"start\"; \"yes\"; \"start\"; if(length(trim(1.subject)) = 0; \"reply\"; if(contains(\"12345\"; substring(trim(1.subject); 0; 1)); \"rating\"; \"reply\")))}}"
            },
            {
              "name": "when",
              "value": "{{formatDate(now; \"ddd M/D h:mm A\"; \"America/New_York\")}}"
            }
          ]
        }
      }
    },
    {
      "id": 3,
      "module": "builtin:BasicRouter",
      "version": 1,
      "config": {}
    },
    {
      "id": 4,
      "module": "datastore:AddRecord",
      "version": 1,
      "config": {
        "parameters": {
          "datastore": "REDACTED_DATASTORE_ID"
        },
        "mapper": {
          "key": "{{2.num}}",
          "data": {
            "opted_out": true,
            "last_texted_at": "{{now}}"
          },
          "overwrite": true
        }
      }
    },
    {
      "id": 11,
      "module": "builtin:BasicRouter",
      "version": 1,
      "config": {
        "mapper": null
      }
    },
    {
